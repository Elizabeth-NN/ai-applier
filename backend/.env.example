# Comma-separated frontend origins. Keep localhost for local development.
FRONTEND_ORIGINS=http://localhost:3000

DB_HOST=localhost
DB_PORT=5432
DB_NAME=ai_applier
DB_USER=ai_applier_user
DB_PASSWORD=replace-with-your-local-password

# Jobicy listing status synchronization
JOBICY_STATUS_SYNC_ENABLED=false
JOBICY_STATUS_SYNC_INTERVAL_HOURS=12

# Clerk backend secret key (required)
CLERK_SECRET_KEY=your-clerk-secret-key

# Optional: use DATABASE_URL instead of the individual DB_* settings.
# DATABASE_URL=postgresql://user:password@host:5432/database

# Private resume storage. Local storage is the default.
RESUME_STORAGE_BACKEND=local
# Optional: defaults to backend/private_uploads.
# RESUME_STORAGE_DIR=

# Optional Cloudflare R2 storage. Install with:
# python -m pip install -r requirements-r2.txt
# Set RESUME_STORAGE_BACKEND=r2 only after configuring all four values.
# R2_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
# R2_BUCKET=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_REGION=auto
# R2_PREFIX=resumes
